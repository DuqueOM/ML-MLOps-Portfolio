{
  "dashboard": {
    "title": "ML Model Performance Dashboard",
    "tags": ["mlops", "performance", "predictions"],
    "timezone": "browser",
    "schemaVersion": 39,
    "panels": [
      {
        "id": 1,
        "title": "Request Rate — All Services (req/s)",
        "type": "timeseries",
        "targets": [
          { "expr": "sum(rate(bankchurn_requests_total[5m]))", "legendFormat": "BankChurn" },
          { "expr": "sum(rate(carvision_requests_total[5m]))", "legendFormat": "CarVision" },
          { "expr": "sum(rate(nlpinsight_requests_total[5m]))", "legendFormat": "NLPInsight" }
        ],
        "fieldConfig": { "defaults": { "unit": "reqps" } },
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}
      },
      {
        "id": 2,
        "title": "Latency P95 — All Services",
        "type": "timeseries",
        "targets": [
          { "expr": "histogram_quantile(0.95, sum(rate(bankchurn_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "BankChurn P95" },
          { "expr": "histogram_quantile(0.95, sum(rate(carvision_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "CarVision P95" },
          { "expr": "histogram_quantile(0.95, sum(rate(nlpinsight_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "NLPInsight P95" }
        ],
        "fieldConfig": { "defaults": { "unit": "s" } },
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}
      },
      {
        "id": 3,
        "title": "Total Requests — All Services",
        "type": "stat",
        "targets": [
          { "expr": "sum(bankchurn_requests_total)", "legendFormat": "BankChurn" },
          { "expr": "sum(carvision_requests_total)", "legendFormat": "CarVision" },
          { "expr": "sum(nlpinsight_requests_total)", "legendFormat": "NLPInsight" }
        ],
        "gridPos": {"h": 4, "w": 12, "x": 0, "y": 8}
      },
      {
        "id": 4,
        "title": "Prometheus Targets UP",
        "type": "stat",
        "targets": [
          { "expr": "count(up == 1)", "legendFormat": "Targets UP" }
        ],
        "gridPos": {"h": 4, "w": 6, "x": 12, "y": 8}
      },
      {
        "id": 5,
        "title": "Model Memory Usage (MB)",
        "type": "timeseries",
        "targets": [
          { "expr": "process_resident_memory_bytes{job='bankchurn-predictor'} / 1024 / 1024", "legendFormat": "BankChurn" },
          { "expr": "process_resident_memory_bytes{job='carvision-intelligence'} / 1024 / 1024", "legendFormat": "CarVision" },
          { "expr": "process_resident_memory_bytes{job='nlpinsight-analyzer'} / 1024 / 1024", "legendFormat": "NLPInsight" }
        ],
        "fieldConfig": { "defaults": { "unit": "decmbytes" } },
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12}
      },
      {
        "id": 6,
        "title": "Avg Latency — All Services",
        "type": "timeseries",
        "targets": [
          { "expr": "rate(bankchurn_request_duration_seconds_sum[5m]) / rate(bankchurn_request_duration_seconds_count[5m])", "legendFormat": "BankChurn Avg" },
          { "expr": "rate(carvision_request_duration_seconds_sum[5m]) / rate(carvision_request_duration_seconds_count[5m])", "legendFormat": "CarVision Avg" },
          { "expr": "rate(nlpinsight_request_duration_seconds_sum[5m]) / rate(nlpinsight_request_duration_seconds_count[5m])", "legendFormat": "NLPInsight Avg" }
        ],
        "fieldConfig": { "defaults": { "unit": "s" } },
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12}
      },
      {
        "id": 7,
        "title": "BankChurn — Predictions by Risk Level",
        "type": "timeseries",
        "targets": [
          { "expr": "bankchurn_predictions_total{risk_level=\"HIGH\"}", "legendFormat": "HIGH risk" },
          { "expr": "bankchurn_predictions_total{risk_level=\"MEDIUM\"}", "legendFormat": "MEDIUM risk" },
          { "expr": "bankchurn_predictions_total{risk_level=\"LOW\"}", "legendFormat": "LOW risk" }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 20}
      },
      {
        "id": 8,
        "title": "Error Rate — All Services",
        "type": "timeseries",
        "targets": [
          { "expr": "sum(rate(bankchurn_requests_total{status=~\"5..\"}[5m]))", "legendFormat": "BankChurn errors" },
          { "expr": "sum(rate(carvision_requests_total{status=~\"5..\"}[5m]))", "legendFormat": "CarVision errors" },
          { "expr": "sum(rate(nlpinsight_requests_total{status=~\"5..\"}[5m]))", "legendFormat": "NLPInsight errors" }
        ],
        "fieldConfig": { "defaults": { "unit": "reqps" } },
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 20}
      }
    ],
    "refresh": "10s",
    "time": {
      "from": "now-30m",
      "to": "now"
    }
  }
}
