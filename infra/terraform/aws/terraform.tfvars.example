# AWS Terraform Variables — Example Configuration
# Copy this file to terraform.tfvars and fill in your values:
#   cp terraform.tfvars.example terraform.tfvars
#
# NEVER commit terraform.tfvars to Git (it's in .gitignore)

# Project identification
project_name = "ml-portfolio"
environment  = "production"

# AWS region (us-east-1 is cheapest for most services)
aws_region = "us-east-1"

# VPC networking
vpc_cidr             = "10.0.0.0/16"
private_subnet_cidrs = ["10.0.1.0/24", "10.0.2.0/24", "10.0.3.0/24"]
public_subnet_cidrs  = ["10.0.101.0/24", "10.0.102.0/24", "10.0.103.0/24"]

# RDS database for MLflow
db_instance_class = "db.t3.micro"  # Smallest production-capable instance
db_username       = "mlflow"
db_password       = "CHANGE_ME_TO_A_SECURE_PASSWORD"  # Use: openssl rand -base64 24
