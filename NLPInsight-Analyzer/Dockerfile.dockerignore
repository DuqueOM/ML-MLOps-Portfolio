# Build context is the repository root (ADR-019). BuildKit reads this file
# instead of the root .dockerignore because it sits next to the Dockerfile.
# Whitelist: everything is excluded unless listed — the root holds GBs of data,
# models and docs that must never reach the daemon.
*

# Workspace metadata the builder needs to install from the lock
!pyproject.toml
!uv.lock
!BankChurn-Predictor/pyproject.toml
!ChicagoTaxi-Demand-Pipeline/pyproject.toml
!NLPInsight-Analyzer/pyproject.toml
!common_utils/pyproject.toml
!NLPInsight-Analyzer/docker/fetch_locked_wheel.py

# What the runtime image copies (the transformer and models are mounted or
# downloaded at runtime, not baked in)
!NLPInsight-Analyzer/configs/
!NLPInsight-Analyzer/src/
!NLPInsight-Analyzer/app/

**/__pycache__
**/*.py[cod]
